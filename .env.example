# =============================================================================
# CONFIGURAÇÃO DE AMBIENTE — checkauto-site
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de rodar o projeto:
#   cp .env.example .env
#
# ⚠️  Nunca commite o arquivo .env com valores reais no repositório.
# ⚠️  Variáveis com prefixo VITE_ vão para o bundle do navegador: são públicas.
#     Segredos (tokens, client secret, chaves privadas) nunca levam VITE_.
# =============================================================================


# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------
# URL pública do site, usada em links absolutos, canonical e sitemap.
# Local: http://localhost:3000 (porta do `npm run dev`)
# Produção: https://www.checkauto.com.br
SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# API DO BACKEND
# -----------------------------------------------------------------------------
# URL base da API, sem barra no final.
# Contrato: docs/api/openapi.json e docs/api/cadastro-aceite-contrato.md
# VITE_API_URL=https://dev-checkauto-service.checkauto.com.br
VITE_API_URL=https://dashiest-frazzledly-vihaan.ngrok-free.dev


# -----------------------------------------------------------------------------
# RECAPTCHA (login e cadastro)
# -----------------------------------------------------------------------------
# Site keys: peça ao time ou copie do .env.development do Checkauto Corp.
# v3: verificação invisível, ação "login" ou "signup".
VITE_RECAPTCHA_SITE_KEY=

# v2 Enterprise: desafio "não sou um robô", mostrado só quando o backend
# responder com o código recaptcha_fallback_required.
VITE_RECAPTCHA_V2_SITE_KEY=


# -----------------------------------------------------------------------------
# SESSÃO
# -----------------------------------------------------------------------------
# Segredo para assinar o cookie de sessão (server-side, nunca no navegador).
# Gere com: openssl rand -base64 32
AUTH_SECRET=


# -----------------------------------------------------------------------------
# LOGIN COM GOOGLE
# -----------------------------------------------------------------------------
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
# (Aplicativo da Web). Em "Origens JavaScript autorizadas", inclua
# http://localhost:3000 e os domínios do site (não usa redirect URI).
# O site só precisa do ID do cliente. O secret fica no backend, nunca no site.
# O backend expõe POST user/login/google/ e POST user/signup/google/.
VITE_GOOGLE_CLIENT_ID=


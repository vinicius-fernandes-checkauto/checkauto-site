{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!node_modules", "!build", "!.react-router"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useTailwindSortedClasses": "error"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"lucide-react": "Importe ícones de ~/shared/components/icons.",
							"cn": "Importe cn de ~/shared/lib/utils."
						}
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["app/shared/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"lucide-react": "Importe ícones de ~/shared/components/icons.",
									"cn": "Importe cn de ~/shared/lib/utils."
								},
								"patterns": [
									{
										"group": ["~/domains", "~/domains/**"],
										"message": "shared não importa domínios."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"app/domains/*/services/**",
				"app/domains/*/types/**",
				"app/domains/*/utils/**",
				"app/domains/*/*.api.ts",
				"app/domains/*/*.mock.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"lucide-react": "Importe ícones de ~/shared/components/icons.",
									"cn": "Importe cn de ~/shared/lib/utils.",
									"react": "Esta camada não usa React: mova o código para components/ ou hooks/.",
									"react-router": "Esta camada não usa React Router: a navegação fica nas rotas e nos componentes."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["app/domains/*/*.api.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"lucide-react": "Importe ícones de ~/shared/components/icons.",
									"cn": "Importe cn de ~/shared/lib/utils.",
									"react": "Esta camada não usa React: mova o código para components/ ou hooks/.",
									"react-router": "Esta camada não usa React Router: a navegação fica nas rotas e nos componentes."
								},
								"patterns": [
									{
										"group": ["~/domains/*/services/**"],
										"message": "A camada de API não chama services/."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"app/shared/components/icons.tsx",
				"app/shared/lib/utils.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"tailwind": {
		"stylesheet": "./app/app.css"
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":NODE:", ":PACKAGE:"],
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	}
}

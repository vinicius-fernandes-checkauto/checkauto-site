{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "yarn install --frozen-lockfile",
	"buildCommand": "yarn build",
	"outputDirectory": "build/client",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
		}
	]
}
